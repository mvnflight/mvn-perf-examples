<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mvn-perf.examples</groupId>
        <artifactId>mvn-perf-examples</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>parallel-tests</artifactId>

    <!-- The intra-module test-parallelism module — built ONLY under the parent's
         "parallel" profile (-Pparallel), so the baseline scaling reactor never
         includes it. It is an independent "filler" leaf (depends only on core),
         like the lib-NN modules, but unlike them it carries FIVE independent test
         classes (Parallel1..5Test), one 15 s test each. With Surefire's forkCount
         (demo.forkCount, default 1) they run serially (~75 s); pass
         -Ddemo.forkCount=5 (the .github/workflows/fork-grid.yml legs) and each class
         runs in its own fork JVM, so all five execute in one parallel wave and the
         module's test phase collapses to ~15 s — mvn-lens then renders one fork
         lane per JVM. This is INTRA-module test parallelism (Surefire forkCount),
         a different axis from the -T reactor parallelism. -->

    <dependencies>
        <dependency>
            <groupId>io.github.mvn-perf.examples</groupId>
            <artifactId>core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
