    <artifactId>pipe-1</artifactId>

    <!-- First link of the critical-path chain core -> pipe-1 -> pipe-2 -> pipe-3
         -> pipe-4. Each link is a fixed 8 s; the four serial links (32 s) are the
         reactor's long pole, which is what the smart builder schedules first. -->
    <properties>
        <demo.sleep.minMs>8000</demo.sleep.minMs>
        <demo.sleep.maxMs>8000</demo.sleep.maxMs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.mvnflight.examples</groupId>
            <artifactId>core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
