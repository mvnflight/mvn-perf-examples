<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mvn-perf.examples</groupId>
        <artifactId>mvn-perf-examples</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>core</artifactId>

    <!-- Foundation module: everyone depends on it, so it gates the start of the
         build (nothing else can run until core finishes). Kept short — fixed 2 s. -->
    <properties>
        <demo.sleep.minMs>2000</demo.sleep.minMs>
        <demo.sleep.maxMs>2000</demo.sleep.maxMs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
