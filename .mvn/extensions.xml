<?xml version="1.0" encoding="UTF-8"?>
<extensions>
    <!-- The JFR build profiler that produces the reports. Resolved from the Maven
         Central snapshot repository, which is declared in .mvn/settings.xml —
         core extensions are resolved by Maven's bootstrap BEFORE the project POM
         is read, so a <repositories> block in pom.xml would never be consulted and
         the built-in `central` repository has snapshots disabled. .mvn/maven.config
         points Maven at that settings file, so a plain `./mvnw clean verify` works
         with no extra flags. The version deliberately floats on 0.1.0-SNAPSHOT:
         every push to mvnflight's main publishes a new snapshot build. -->
    <extension>
        <groupId>io.github.mvnflight</groupId>
        <artifactId>mvnflight-extension</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </extension>

    <!-- Takari smart builder: enables `mvn -b smart`, which schedules modules by
         critical path (heaviest-first) instead of the default multithreaded
         topological order. The scaling grid (.github/workflows/scaling-grid.yml)
         compares the two at each -T width. -->
    <extension>
        <groupId>io.takari.maven</groupId>
        <artifactId>takari-smart-builder</artifactId>
        <version>1.1.0</version>
    </extension>
</extensions>
