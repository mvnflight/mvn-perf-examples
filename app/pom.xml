    <artifactId>app</artifactId>

    <!-- Aggregator: depends on the four filler libs AND on the tip of the pipe
         chain (pipe-4), so it cannot start until BOTH the fillers and the whole
         critical-path chain have finished — it gates the end of the build. Kept
         short — fixed 2 s. -->
    <properties>
        <demo.sleep.minMs>2000</demo.sleep.minMs>
        <demo.sleep.maxMs>2000</demo.sleep.maxMs>
    </properties>

    <dependencies>
